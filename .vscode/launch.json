{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: uv dev",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "fastapi",
      "args": [
        "dev",
        "app/main.py"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "subProcess": true,
      "justMyCode": true
    }
  ]
}
